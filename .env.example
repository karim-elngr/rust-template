# Local-only credentials. Compose binds published ports to loopback.
APP_ENV=local
API_AUTH_MODE=local-unsafe
DATABASE_URL=postgres://app:app@localhost:5432/commerce
DB_MAX_CONNECTIONS=10
HTTP_ADDR=127.0.0.1:8080
GRPC_ADDR=127.0.0.1:50051
HEALTH_ADDR=127.0.0.1:9000
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=commerce.events.v1
KAFKA_GROUP_ID=commerce-workflows-v1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
RUST_LOG=info
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TIMEOUT=2000
OTEL_METRIC_EXPORT_INTERVAL=10000
TELEMETRY_SHUTDOWN_TIMEOUT_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=25
REQUEST_TIMEOUT_SECONDS=10
POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=60
EXPIRY_BATCH_SIZE=100
LOG_BUFFER_LINES=8192

# Optional local image overrides. Company CI requires @sha256 refs instead.
BUILDER_IMAGE=rust-template-tools:local
RUNTIME_IMAGE=rust-template-runtime:local
# Limit simultaneous release links; use 1 on small container VMs.
CARGO_BUILD_JOBS=2
